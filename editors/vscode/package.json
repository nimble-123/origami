{
  "name": "abap-origami",
  "displayName": "origami – ABAP & CDS formatter",
  "description": "Layout-only formatter for ABAP, CDS views, metadata extensions, access controls, behavior definitions and service definitions. Works on abapGit files and ADT for VS Code documents.",
  "version": "0.3.0",
  "icon": "icon.png",
  "publisher": "nimble-123",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimble-123/origami.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://nimble-123.github.io/origami/",
  "bugs": {
    "url": "https://github.com/nimble-123/origami/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "abap",
    "cds",
    "rap",
    "formatter",
    "abapgit"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:abap",
    "onLanguage:acds",
    "workspaceContains:**/*.abap",
    "workspaceContains:**/*.asddls",
    "workspaceContains:**/*.asddlxs",
    "workspaceContains:**/*.asdcls",
    "workspaceContains:**/*.asbdef",
    "workspaceContains:**/*.srvdsrv"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces only the bundled origami binary is used."
    }
  },
  "contributes": {
    "configuration": {
      "title": "origami",
      "properties": {
        "origami.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to an origami binary. Empty: use an origami on PATH that satisfies the project's required_version, else the bundled binary."
        },
        "origami.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log every origami command line and its stderr to the 'origami' output channel."
        }
      }
    },
    "commands": [
      {
        "command": "origami.showOutput",
        "title": "origami: Show Output"
      },
      {
        "command": "origami.previewChanges",
        "title": "origami: Preview Changes"
      },
      {
        "command": "origami.applyPreview",
        "title": "origami: Apply Preview",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "origami.applyPreview",
          "when": "resourceScheme == origami-preview",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "origami.previewChanges",
          "when": "origami.formattable"
        },
        {
          "command": "origami.applyPreview",
          "when": "origami.previewActive"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js",
    "package": "vsce package",
    "lint": "eslint .",
    "test:e2e": "npm run build && tsc -p tsconfig.e2e.json && node out-test/test/e2e/run.js"
  },
  "dependencies": {
    "diff": "9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
