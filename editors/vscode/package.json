{
  "name": "abap-origami",
  "displayName": "origami \u2013 ABAP & CDS formatter",
  "description": "Layout-only formatter for ABAP, CDS views, metadata extensions, access controls, behavior definitions and service definitions. Works on abapGit files and ADT for VS Code documents.",
  "version": "0.1.0",
  "publisher": "origami-dev",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "abap",
    "cds",
    "rap",
    "formatter",
    "abapgit"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:abap",
    "onLanguage:acds",
    "workspaceContains:**/*.abap",
    "workspaceContains:**/*.asddls",
    "workspaceContains:**/*.asddlxs",
    "workspaceContains:**/*.asdcls",
    "workspaceContains:**/*.asbdef",
    "workspaceContains:**/*.srvdsrv"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces only the bundled origami binary is used."
    }
  },
  "contributes": {
    "configuration": {
      "title": "origami",
      "properties": {
        "origami.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to an origami binary. Empty: use an origami on PATH that satisfies the project's required_version, else the bundled binary."
        },
        "origami.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log every origami command line and its stderr to the 'origami' output channel."
        }
      }
    },
    "commands": [
      {
        "command": "origami.showOutput",
        "title": "origami: Show Output"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "diff": "9.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
